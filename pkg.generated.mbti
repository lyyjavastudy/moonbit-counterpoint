// Errors

// Types and methods
pub(all) struct Analysis {
  species : Species
  findings : Array[Finding]
} derive(Eq, ToJson, @debug.Debug)
pub fn Analysis::is_clean(Self) -> Bool

pub(all) struct AnalysisExport {
  title : String
  profile : String
  summary : AnalysisSummary
  findings : Array[String]
  recommendations : Array[String]
  fingerprint : String
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct AnalysisHistory {
  snapshots : Array[AnalysisSnapshot]
  best_score : Int
  latest_score : Int
  improvement : Int
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct AnalysisOptions {
  species : Species
  strict_cadence : Bool
  max_melody_span : Int
  max_leap : Int
} derive(Eq, ToJson, @debug.Debug)
pub fn AnalysisOptions::default(species~ : Species) -> Self

pub(all) struct AnalysisSnapshot {
  label : String
  score : Int
  errors : Int
  warnings : Int
  notes : Int
  profile : String
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct AnalysisSummary {
  total : Int
  errors : Int
  warnings : Int
  infos : Int
  structural : Int
  harmonic : Int
  score : Int
} derive(Eq, ToJson, @debug.Debug)
pub fn AnalysisSummary::grade(Self) -> String
pub fn AnalysisSummary::passed(Self) -> Bool
pub fn AnalysisSummary::severity_total(Self) -> Int

pub(all) struct BatchReport {
  labels : Array[String]
  summaries : Array[AnalysisSummary]
  best_index : Int
  best_score : Int
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct BeatPoint {
  index : Int
  time : Int
  measure : Int
  beat : Int
  strength : BeatStrength
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum BeatStrength {
  Downbeat
  Strong
  Weak
  Offbeat
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct CadencePlan {
  penultimate : Int
  final_pitch : Int
  final_interval : Int
  approach : Direction
  valid : Bool
  message : String
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct CandidateBatch {
  source : Note
  candidates : Array[PitchCandidate]
  accepted : Int
  rejected : Int
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct CandidatePolicy {
  low : Int
  high : Int
  max_leap : Int
  require_consonance : Bool
  prefer_contrary : Bool
  avoid_repetition : Bool
} derive(Eq, ToJson, @debug.Debug)
pub fn CandidatePolicy::default() -> Self
pub fn CandidatePolicy::is_valid(Self) -> Bool
pub fn CandidatePolicy::strict() -> Self

pub(all) enum ConsonanceClass {
  Perfect
  Imperfect
  Dissonant
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum ContourStep {
  Rising
  Falling
  Repeated
  LeapUp
  LeapDown
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct ContourSummary {
  notes : Int
  rising : Int
  falling : Int
  repeated : Int
  leaps : Int
  turning_points : Int
  first_pitch : Int
  last_pitch : Int
  range : Int
} derive(Eq, ToJson, @debug.Debug)

pub(all) enum Direction {
  Up
  Down
  Same
} derive(Eq, ToJson, @debug.Debug)

pub(all) struct ExerciseSpec {
  id : String
  rule : RuleKind
  species : Species
  title : String
  objective : String
  prompt : String
  target : String
